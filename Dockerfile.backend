FROM python:3.10-slim AS backend-build

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=config.settings.prod

WORKDIR /app/backend

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY backend/requirements /app/backend/requirements
RUN pip install --upgrade pip && \
    pip install -r requirements/prod.txt

# Copy backend code
COPY backend/ .

# Create media directory and set permissions
RUN mkdir -p /app/backend/media && \
    chmod -R 755 /app/backend/media

# Add wait-for-it script
COPY backend/wait-for-it.sh /app/backend/wait-for-it.sh
RUN chmod +x /app/backend/wait-for-it.sh

EXPOSE 8000

CMD ["sh", "-c", "\
    /app/backend/wait-for-it.sh db:5432 -- \
    sh -c '\
      python manage.py makemigrations && \
      python manage.py migrate && \
      python manage.py collectstatic --noinput && \
      gunicorn config.wsgi:application --bind 0.0.0.0:8000'"]