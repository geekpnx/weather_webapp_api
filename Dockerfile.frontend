FROM node:18-alpine AS build
WORKDIR /app

COPY frontend/package*.json ./
RUN npm install

# Create production env file from build args
RUN echo "DOMAIN=${DOMAIN}" > .env.production && \
    echo "PROTOCOL=${PROTOCOL}" >> .env.production && \
    echo "BASE_URL=${PROTOCOL}://${DOMAIN}" >> .env.production && \
    echo "VITE_STATIC_BASE_URL=\${BASE_URL}/static" >> .env.production && \
    echo "VITE_MEDIA_BASE_URL=\${BASE_URL}/media" >> .env.production && \
    echo "VITE_WEATHER_API_BASE_URL=\${BASE_URL}/api/v1/weather" >> .env.production && \
    echo "VITE_USER_API_BASE_URL=\${BASE_URL}/api/v1/user" >> .env.production && \
    echo "VITE_OPENWEATHERMAP_API_KEY=${VITE_OPENWEATHERMAP_API_KEY}" >> .env.production && \
    echo "VITE_OPENWEATHERMAP_API_BASE_URL=${VITE_OPENWEATHERMAP_API_BASE_URL}" >> .env.production && \
    echo "VITE_OPENWEATHERMAP_BASE_URL=${VITE_OPENWEATHERMAP_BASE_URL}" >> .env.production

COPY frontend/ .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]