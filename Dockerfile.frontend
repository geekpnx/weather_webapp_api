# Stage 1: Build the React/Vite App
FROM node:18-alpine AS build
WORKDIR /app

# Install dependencies first (better caching)
COPY frontend/package*.json ./
RUN npm install

# Copy all files including the .env.production created by GitHub Actions
COPY frontend/ .
COPY frontend/.env.production .

# Verify environment file exists and contains expected values
RUN cat .env.production

# Build the app
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Remove default config and copy our custom config
RUN rm -rf /etc/nginx/conf.d/default.conf
COPY frontend/nginx.conf /etc/nginx/conf.d/

# Copy build output
COPY --from=build /app/dist /usr/share/nginx/html

# Create media and static directories and set permissions
RUN mkdir -p /usr/share/nginx/html/media && \
    mkdir -p /usr/share/nginx/html/static && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

VOLUME ["/usr/share/nginx/html/media", "/usr/share/nginx/html/static"]

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
