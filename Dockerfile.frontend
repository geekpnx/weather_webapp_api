FROM node:18-alpine AS build
WORKDIR /app

# Copy package files first
COPY frontend/package*.json ./
RUN npm install

# Create production env file from build args
ARG VITE_OPENWEATHERMAP_API_KEY
ARG VITE_OPENWEATHERMAP_API_BASE_URL
ARG VITE_OPENWEATHERMAP_BASE_URL
ARG DOMAIN
ARG PROTOCOL

RUN echo "VITE_OPENWEATHERMAP_API_KEY=${VITE_OPENWEATHERMAP_API_KEY}" > .env.production && \
    echo "VITE_OPENWEATHERMAP_API_BASE_URL=${VITE_OPENWEATHERMAP_API_BASE_URL}" >> .env.production && \
    echo "VITE_OPENWEATHERMAP_BASE_URL=${VITE_OPENWEATHERMAP_BASE_URL}" >> .env.production && \
    echo "DOMAIN=${DOMAIN}" >> .env.production && \
    echo "PROTOCOL=${PROTOCOL}" >> .env.production && \
    echo "BASE_URL=${PROTOCOL}://${DOMAIN}" >> .env.production

# Copy remaining files and build
COPY frontend/ .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]